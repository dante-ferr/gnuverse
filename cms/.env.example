# Gere um segredo aleatório. Não use este texto como segredo real.
PAYLOAD_SECRET=
# Só em produção: URL HTTPS pública do CMS. Localmente usa CMS_PORT da raiz.
CMS_SERVER_URL=
DATABASE_ADAPTER=sqlite
DATABASE_URL=file:./data/gnuverse.db
# Na nuvem: DATABASE_ADAPTER=postgres e connection string do Supabase.
# STORAGE_ADAPTER=s3 é obrigatório na nuvem; local só para desenvolvimento.
STORAGE_ADAPTER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL secreta do deploy hook do site no Cloudflare Pages. Opcional localmente.
SITE_DEPLOY_HOOK_URL=
