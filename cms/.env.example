# Gere um segredo aleatório. Não use este texto como segredo real.
# `make setup` copia este arquivo para cms/.env e preenche PAYLOAD_SECRET.
PAYLOAD_SECRET=
# Conta administradora criada automaticamente só quando o banco ainda não tem usuários.
# Mudar estas variáveis depois NÃO atualiza a conta existente — use `make cms-set-host-admin`
# (ou `npm run set-host-admin` em cms/) com o ambiente já carregado. Em produção no Render Shell:
# defina HOST_ADMIN_* (e opcionalmente HOST_ADMIN_MATCH_EMAIL) e rode o comando.
HOST_ADMIN_EMAIL=admin@gnuverse.local
HOST_ADMIN_PASSWORD=gnuverse123
HOST_ADMIN_NAME=Administrador
# Apelido público único para entrar (e-mail ou este valor). Padrão: admin.
HOST_ADMIN_USERNAME=admin
# Opcional ao redefinir: e-mail atual da conta admin quando você está trocando o e-mail.
# HOST_ADMIN_MATCH_EMAIL=
# Só em produção: URL HTTPS pública do CMS. Localmente usa CMS_PORT da raiz.
CMS_SERVER_URL=
# Origens extras autorizadas para CORS/CSRF separadas por vírgula (ex.: URL pública do portal).
CMS_ALLOWED_ORIGINS=
DATABASE_ADAPTER=sqlite
DATABASE_URL=file:./data/gnuverse.db
# Na nuvem: DATABASE_ADAPTER=postgres e connection string do Supabase.
# STORAGE_ADAPTER=s3 é obrigatório na nuvem; local só para desenvolvimento.
STORAGE_ADAPTER=local
# SMTP local (Mailpit): make mailpit e abra a URL do inbox impressa (padrão http://127.0.0.1:8025)
# Em produção: host do provedor, porta 587 (STARTTLS) ou 465 (SMTPS), usuário/senha do provedor.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=gnuverse@localhost
SMTP_FROM_NAME=GNUverse
# Links nos e-mails de verificação e recuperação de senha. Obrigatório em produção (URL do site).
GNUVERSE_SITE_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL secreta do deploy hook do site no Cloudflare Pages. Opcional localmente.
SITE_DEPLOY_HOOK_URL=
