# Gere um segredo aleatório. Não use este texto como segredo real.
# `make setup` copia este arquivo para cms/.env e preenche PAYLOAD_SECRET.
PAYLOAD_SECRET=
# Conta administradora criada automaticamente na primeira inicialização do banco.
# Troque a senha em produção. Localmente estes valores bastam para entrar em /admin.
HOST_ADMIN_EMAIL=admin@gnuverse.local
HOST_ADMIN_PASSWORD=gnuverse123
HOST_ADMIN_NAME=Administrador
# Apelido público único para entrar (e-mail ou este valor). Padrão: admin.
HOST_ADMIN_USERNAME=admin
# Só em produção: URL HTTPS pública do CMS. Localmente usa CMS_PORT da raiz.
CMS_SERVER_URL=
# Origens extras autorizadas para CORS/CSRF separadas por vírgula (ex.: URL pública do portal).
CMS_ALLOWED_ORIGINS=
DATABASE_ADAPTER=sqlite
DATABASE_URL=file:./data/gnuverse.db
# Na nuvem: DATABASE_ADAPTER=postgres e connection string do Supabase.
# STORAGE_ADAPTER=s3 é obrigatório na nuvem; local só para desenvolvimento.
STORAGE_ADAPTER=local
# SMTP local (Mailpit): make mailpit e abra http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_ADDRESS=gnuverse@localhost
SMTP_FROM_NAME=GNUverse
# Links nos e-mails de verificação e recuperação de senha (porta do site).
GNUVERSE_SITE_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL secreta do deploy hook do site no Cloudflare Pages. Opcional localmente.
SITE_DEPLOY_HOOK_URL=
