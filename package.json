{
  "name": "gnuverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "predev": "npm run content:sync",
    "prebuild": "npm run content:sync",
    "content:sync": "node scripts/sync-content.mjs",
    "cms:setup": "node cms/scripts/setup-local.mjs",
    "cms:dev": "npm --prefix cms run dev",
    "cms:typecheck": "npm --prefix cms run typecheck",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@payloadcms/richtext-lexical": "3.90.2",
    "graphql": "16.14.2",
    "next": "16.4.1",
    "payload": "3.90.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
