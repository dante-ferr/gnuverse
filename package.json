{
  "name": "gnuverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "predev": "npm run content:sync",
    "prebuild": "npm run content:sync",
    "content:sync": "node scripts/sync-content.mjs",
    "cms:setup": "node cms/scripts/setup-local.mjs",
    "cms:bootstrap": "npm --prefix cms run bootstrap:local",
    "cms:reset-db": "node cms/scripts/reset-local-db.mjs",
    "cms:seed": "npm --prefix cms run seed:demo",
    "cms:set-host-admin": "npm --prefix cms run set-host-admin",
    "cms:dev": "npm --prefix cms run dev",
    "cms:typecheck": "npm --prefix cms run typecheck",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "test:blog": "node scripts/test-blog.ts",
    "test:blog:ci": "node scripts/test-blog.ts --once --no-browser",
    "game:dev": "node --watch --env-file-if-exists=.env.local game-server/index.ts",
    "elements:build": "node scripts/elements/build.mjs",
    "elements:serve": "node scripts/elements/serve.mjs",
    "elements:graph": "node scripts/visualize-elements.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@payloadcms/richtext-lexical": "3.90.2",
    "graphql": "16.14.2",
    "next": "16.4.1",
    "payload": "3.90.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "type": "module"
}
