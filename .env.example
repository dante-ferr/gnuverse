# demo usa apenas o exemplo identificado como demonstração; live lê o CMS.
CMS_CONTENT_MODE=demo
# Porta local do CMS: origem única para o painel, espera da API e sincronização.
CMS_PORT=3001
# Só para CMS remoto/produção. Vazio deriva http://localhost:${CMS_PORT}.
CMS_URL=

# Backend Node independente do CMS; a porta local do jogo é 3002 (CMS usa 3001).
GAME_PORT=3002
# Ativa moedas ilimitadas apenas fora de NODE_ENV=production.
GAME_INFINITE_COINS=false
# Endereço de escuta local; use 0.0.0.0 para aceitar conexões da rede local.
GAME_HOST=127.0.0.1
# NEXT_PUBLIC_* é público: deve conter somente a URL pública da API do jogo.
NEXT_PUBLIC_GAME_API_URL=http://localhost:3002
# Caminho do banco SQLite do jogo; caminho relativo à raiz do repositório.
GAME_DB_PATH=.content/game.sqlite
# Lista separada por vírgulas de origens autorizadas pelo backend.
GAME_ALLOWED_ORIGINS=http://localhost:3000
# Caminho opcional para outro arquivo TOML; relativo à raiz do projeto.
GAME_CONFIG_PATH=
